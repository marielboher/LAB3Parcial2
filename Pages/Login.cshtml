@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Acceso de clientes</p>
        <h1>Iniciar sesión</h1>
        <p>Ingrese el usuario y la contraseña registrados para entrar a su espacio personal.</p>
    </div>
</section>

<section class="section">
    <div class="container form-layout form-layout-narrow">
        <div class="form-card">
            @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
            {
                <div class="alert alert-success">@Model.Mensaje</div>
            }

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.Usuario" class="form-label"></label>
                    <input asp-for="Input.Usuario" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Usuario" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Contrasena" class="form-label"></label>
                    <input asp-for="Input.Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-gold">Ingresar</button>
            </form>

            <p class="form-footnote">
                ¿Aún no tiene cuenta? <a asp-page="/Registro">Regístrese aquí</a>
            </p>
        </div>
        <aside class="form-aside">
            <img src="~/imagenes/banner-empresa.png" alt="Banner institucional" class="aside-banner" />
            <p>Al iniciar sesión será dirigido a su propio espacio de gestión de archivos.</p>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

