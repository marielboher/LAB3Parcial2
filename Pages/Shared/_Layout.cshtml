@{
    var usuarioSesion = Context.Session.GetString("Usuario");
    var autenticado = Context.Session.GetString("Autenticado") == "true";
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool Activa(string pagina) => string.Equals(paginaActual, pagina, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Asesoría Legal Global</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <img src="~/imagenes/logo-navbar.png" alt="Logo Asesoría Legal Global" class="brand-logo" />
                    <span class="brand-text">
                        <strong>Asesoría Legal</strong>
                        <small>Global</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="toggler-bar"></span>
                    <span class="toggler-bar"></span>
                    <span class="toggler-bar"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(Activa("/Index") ? "active" : "")" asp-page="/Index">Inicio</a>
                        </li>
                        @if (!autenticado)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(Activa("/Registro") ? "active" : "")" asp-page="/Registro">Registro</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Activa("/Login") ? "active" : "")" asp-page="/Login">Iniciar sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(Activa("/Gestion") ? "active" : "")" asp-page="/Gestion">Mi espacio</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-user">@usuarioSesion</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-logout" asp-page="/Logout">Cerrar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <img src="~/imagenes/logo-navbar.png" alt="Asesoría Legal Global" class="footer-logo" />
                    <p>Asesoramiento legal profesional y gestión segura de documentos para clientes particulares y empresas.</p>
                </div>
                <div>
                    <h3>Navegación</h3>
                    <ul>
                        <li><a asp-page="/Index">Inicio</a></li>
                        <li><a asp-page="/Registro">Registro de clientes</a></li>
                        <li><a asp-page="/Login">Iniciar sesión</a></li>
                        <li><a asp-page="/Gestion">Gestión de documentos</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Contacto</h3>
                    <ul>
                        <li>Córdoba, Argentina</li>
                        <li>consultas@asesorialegal.global</li>
                        <li>+54 351 555-0148</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Asesoría Legal Global. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
